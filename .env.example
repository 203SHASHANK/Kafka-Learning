# ============================================================
# Kafka Learning - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# The .env file is git-ignored; never commit real credentials.

# ------------------------------------------------------------
# Kafka Connection
# ------------------------------------------------------------
# Comma-separated list of broker addresses.
# Single node: localhost:9092
# Multi-node:  localhost:9092,localhost:9093,localhost:9094
KAFKA_BROKERS=localhost:9092

# Kafka protocol version. Must be <= your cluster version.
# Run: kafka-broker-api-versions --bootstrap-server localhost:9092 | grep "Broker Version"
KAFKA_VERSION=3.6.0

# Consumer group ID. All instances with the same ID share partition ownership.
KAFKA_CONSUMER_GROUP=kafka-learning-group

# ------------------------------------------------------------
# Producer Configuration
# ------------------------------------------------------------
# How many times to retry a failed produce before giving up.
KAFKA_PRODUCER_RETRY_MAX=5

# Acknowledgement policy:
#   none  (0) - fire and forget, highest throughput, no durability guarantee
#   local (1) - leader acknowledges, good default
#   all  (-1) - all ISR replicas acknowledge, highest durability
KAFKA_PRODUCER_REQUIRED_ACKS=all

# How often the async producer flushes its internal buffer.
KAFKA_PRODUCER_FLUSH_FREQUENCY=500ms

# Compression algorithm: none, gzip, snappy, lz4, zstd
# Snappy is a good default: fast, decent compression ratio.
KAFKA_PRODUCER_COMPRESSION=snappy

# Enable idempotent producer (prevents duplicate messages on retry).
# Required for exactly-once semantics.
KAFKA_PRODUCER_IDEMPOTENT=false

# Transaction ID for transactional producer. Leave empty to disable transactions.
KAFKA_PRODUCER_TRANSACTION_ID=

# ------------------------------------------------------------
# Consumer Configuration
# ------------------------------------------------------------
# Disable auto-commit for manual control over when offsets are committed.
# Manual commit = "I processed this message, advance the offset."
# Auto-commit can cause message loss if your app crashes between consume and commit.
KAFKA_CONSUMER_AUTO_COMMIT=false

# Where to start consuming if no committed offset exists for this group:
#   newest  - only process new messages (default for most use cases)
#   oldest  - replay all messages from the beginning (useful for reprocessing)
KAFKA_CONSUMER_OFFSET_INITIAL=newest

# How long Kafka waits before declaring a consumer dead and triggering rebalance.
KAFKA_CONSUMER_SESSION_TIMEOUT=10s

# How often the consumer sends heartbeats (must be < 1/3 of session timeout).
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3s

# ------------------------------------------------------------
# Topic Names
# ------------------------------------------------------------
TOPIC_ORDERS=orders
TOPIC_ORDERS_DLQ=orders.dlq
TOPIC_PAYMENTS=payments
TOPIC_EVENTS=events

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
METRICS_PORT=2112
